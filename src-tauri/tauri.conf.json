{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepWrite",
  "version": "0.1.0",
  "identifier": "com.deepwrite.desktop",
  "build": {
    "beforeDevCommand": "pnpm.cmd dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm.cmd build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepWrite",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:deepwrite.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Local-first long-form writing editor",
    "longDescription": "DeepWrite is a local-first long-form writing editor with optional DeepSeek-assisted revision.",
    "fileAssociations": [
      {
        "ext": ["dwrite"],
        "name": "DeepWrite Document",
        "description": "DeepWrite local document",
        "mimeType": "application/x-deepwrite"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
