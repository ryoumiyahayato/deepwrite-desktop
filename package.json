{
  "name": "deepwrite-desktop",
  "private": true,
  "version": "0.1.1",
  "description": "Local-first long-form writing desktop editor with DeepSeek-assisted revision.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:windows-bundle": "node scripts/validate-windows-bundle.mjs",
    "validate:windows-artifact": "node scripts/validate-windows-bundle.mjs --release",
    "build": "node scripts/validate-windows-bundle.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "@tauri-apps/plugin-stronghold": "^2",
    "@tiptap/core": "^3",
    "@tiptap/extension-color": "^3",
    "@tiptap/extension-font-family": "^3",
    "@tiptap/extension-highlight": "^3",
    "@tiptap/extension-image": "^3",
    "@tiptap/extension-link": "^3",
    "@tiptap/extension-table": "^3",
    "@tiptap/extension-table-cell": "^3",
    "@tiptap/extension-table-header": "^3",
    "@tiptap/extension-table-row": "^3",
    "@tiptap/extension-text-align": "^3",
    "@tiptap/extension-text-style": "^3",
    "@tiptap/extension-underline": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "docx": "^9",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "marked": "^15.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "turndown": "^7.2.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
